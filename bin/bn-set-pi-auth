#!/usr/bin/env bash

set -euo pipefail

PI_AUTH="$HOME/.pi/agent/auth.json"

[[ -f "$PI_AUTH" ]] || {
    echo "Error: $PI_AUTH does not exist" >&2
    exit 1
}

if ! key=$(opencode service get env LITELLM_BARRACUDA_API_KEY); then
    echo "Error: failed to retrieve LITELLM_BARRACUDA_API_KEY from OpenCode service" >&2
    exit 1
fi

[[ -n "$key" ]] || {
    echo "Error: OpenCode service returned an empty LITELLM_BARRACUDA_API_KEY" >&2
    exit 1
}

[[ "$key" =~ [^[:space:]] ]] || {
    echo "Error: OpenCode service returned a whitespace-only LITELLM_BARRACUDA_API_KEY" >&2
    exit 1
}

piAuthDirectory=${PI_AUTH%/*}
tmp=$(mktemp "$piAuthDirectory/.auth.json.XXXXXX")
trap 'rm -f "$tmp"' EXIT

LITELLM_BARRACUDA_API_KEY="$key" jq '
    .["barracuda-iq"].key = $ENV.LITELLM_BARRACUDA_API_KEY
' "$PI_AUTH" > "$tmp"

mv "$tmp" "$PI_AUTH"
trap - EXIT
