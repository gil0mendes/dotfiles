{
	"$schema": "https://opencode.ai/config.json",
	"agent": {
		"plan": {
			"model": "litellm-barracuda-openai/gpt-5-6-sol"
		},
		"build": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"general": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"explore": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		},
		"coder": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"librarian": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"oracle": {
			"model": "litellm-barracuda/claude-opus-4-8"
		},
		"researcher": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		},
		"reviewer": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"scribe": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		}
	},
	"provider": {
		"litellm-barracuda": {
			"name": "LiteLLM (Barracuda)",
			"npm": "@ai-sdk/openai-compatible",
			"models": {
				"claude-opus-4-8": {
					"id": "claude-opus-4-8"
				},
				"claude-sonnet-5": {
					"id": "claude-sonnet-5"
				},
				"claude-haiku-4-5": {
					"id": "claude-sonnet-5"
				},
				"gemini-2-5-flash": {
					"id": "gemini-2-5-flash"
				}
			},
			"options": {
				"baseURL": "https://api.iq.cudasvc.com"
			}
		},
		"litellm-barracuda-openai": {
			"name": "LiteLLM OpenAI (Barracuda)",
			"npm": "@ai-sdk/openai",
			"models": {
				"gpt-5-5": {
					"id": "gpt-5-5"
				},
				"gpt-5-4-mini": {
					"id": "gpt-5-4-mini"
				},
				"gpt-5-6-sol": {
					"id": "gpt-5-6-sol"
				},
				"gpt-5-6-terra": {
					"id": "gpt-5-6-terra"
				},
				"gpt-5-6-luna": {
					"id": "gpt-5-6-luna"
				}
			},
			"options": {
				"baseURL": "https://api.iq.cudasvc.com"
			}
		}
	},
	"enabled_providers": [
		"openai",
		"opencode",
		"litellm-barracuda",
		"litellm-barracuda-openai",
		"lmstudio"
	]
}
