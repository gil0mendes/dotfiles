{
	"$schema": "https://opencode.ai/config.json",
	"agents": {
		"plan": {
			"model": "litellm-barracuda-openai/gpt-5-6-sol"
		},
		"build": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"general": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"explore": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		},
		"coder": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra#xhigh"
		},
		"librarian": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"oracle": {
			"model": "litellm-barracuda/claude-opus-4-8"
		},
		"researcher": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		},
		"reviewer": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"scribe": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		}
	},
	"providers": {
		"litellm-barracuda": {
			"name": "LiteLLM (Barracuda)",
			"package": "aisdk:@ai-sdk/openai-compatible",
			"settings": {
				"baseURL": "https://api.iq.cudasvc.com"
			},
			"models": {
				"claude-opus-4-8": {
					"modelID": "claude-opus-4-8"
				},
				"claude-sonnet-5": {
					"modelID": "claude-sonnet-5"
				},
				"claude-haiku-4-5": {
					"modelID": "claude-sonnet-5"
				},
				"gemini-2-5-flash": {
					"modelID": "gemini-2-5-flash"
				}
			}
		},
		"litellm-barracuda-openai": {
			"name": "LiteLLM OpenAI (Barracuda)",
			"package": "aisdk:@ai-sdk/openai",
			"settings": {
				"baseURL": "https://api.iq.cudasvc.com"
			},
			"models": {
				"gpt-5-5": {
					"modelID": "gpt-5-5"
				},
				"gpt-5-4-mini": {
					"modelID": "gpt-5-4-mini"
				},
				"gpt-5-6-sol": {
					"modelID": "gpt-5-6-sol"
				},
				"gpt-5-6-terra": {
					"modelID": "gpt-5-6-terra"
				},
				"gpt-5-6-luna": {
					"modelID": "gpt-5-6-luna"
				}
			}
		}
	},
	"experimental": {
		"policies": [
			{
				"action": "provider.use",
				"resource": "*",
				"effect": "deny"
			},
			{
				"action": "provider.use",
				"resource": "openai",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "opencode",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "litellm-barracuda",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "litellm-barracuda-openai",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "lmstudio",
				"effect": "allow"
			}
		]
	}
}
