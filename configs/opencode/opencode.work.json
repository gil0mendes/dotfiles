{
	"$schema": "https://opencode.ai/config.json",
	"agents": {
		"plan": {
			"model": "litellm-barracuda-openai/gpt-5-6-sol"
		},
		"build": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"general": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"explore": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		},
		"coder": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra#xhigh"
		},
		"librarian": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"oracle": {
			"model": "litellm-barracuda/claude-opus-4-8"
		},
		"researcher": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		},
		"reviewer": {
			"model": "litellm-barracuda-openai/gpt-5-6-terra"
		},
		"scribe": {
			"model": "litellm-barracuda-openai/gpt-5-6-luna"
		}
	},
	"providers": {
		"litellm-barracuda": {
			"name": "LiteLLM (Barracuda)",
			"env": ["LITELLM_BARRACUDA_API_KEY"],
			"package": "@opencode/ai/providers/openai-compatible",
			"settings": {
				"baseURL": "https://api.iq.cudasvc.com/v1"
			},
			"models": {
				"claude-opus-4-8": {
					"modelID": "claude-opus-4-8",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"claude-sonnet-5": {
					"modelID": "claude-sonnet-5",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"claude-haiku-4-5": {
					"modelID": "claude-haiku-4-5",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"gemini-2-5-flash": {
					"modelID": "gemini-2-5-flash"
				}
			}
		},
		"litellm-barracuda-openai": {
			"name": "LiteLLM OpenAI (Barracuda)",
			"env": ["LITELLM_BARRACUDA_OPENAI_API_KEY"],
			"package": "@opencode/ai/providers/openai",
			"settings": {
				"baseURL": "https://api.iq.cudasvc.com/v1"
			},
			"models": {
				"gpt-5-5": {
					"modelID": "gpt-5-5",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"gpt-5-4-mini": {
					"modelID": "gpt-5-4-mini",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"gpt-5-6-sol": {
					"modelID": "gpt-5-6-sol",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"gpt-6-1-sol": {
					"modelID": "gpt-6-1-sol",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"gpt-5-6-terra": {
					"modelID": "gpt-5-6-terra",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
					"variants": [
						{
							"id": "xhigh",
							"settings": {
								"reasoningEffort": "xhigh"
							}
						}
					]
				},
				"gpt-5-6-luna": {
					"modelID": "gpt-5-6-luna",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				},
				"gpt-6-luna": {
					"modelID": "gpt-6-luna",
					"capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
				}
			}
		}
	},
	"experimental": {
		"policies": [
			{
				"action": "provider.use",
				"resource": "*",
				"effect": "deny"
			},
			{
				"action": "provider.use",
				"resource": "openai",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "opencode",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "litellm-barracuda",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "litellm-barracuda-openai",
				"effect": "allow"
			},
			{
				"action": "provider.use",
				"resource": "lmstudio",
				"effect": "allow"
			}
		]
	}
}
